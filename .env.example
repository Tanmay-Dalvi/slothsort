# ==============================================================================
# SlothSort Environment Configuration Example
# Copy this file to .env and adjust values for your local environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (FastAPI)
# ------------------------------------------------------------------------------

# Default AI provider on startup: "ollama" (recommended), "gemini", or "mock"
SLOTHSORT_DEFAULT_PROVIDER=ollama

# Local Ollama daemon endpoint (default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Open-weight local model for organization (default: gemma3:1b)
OLLAMA_MODEL=gemma3:1b

# Optional Hosted Google Gemini API configuration
# Leave empty for 100% offline, local-only mode.
# NEVER commit your real API key to version control!
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Allowed Root Directories for Organization (Comma-separated absolute paths)
# SlothSort will refuse to scan or organize any folder outside these roots.
# Default: User Home directory and /tmp
# Example: SLOTHSORT_ALLOWED_ROOTS=/home/youruser,/tmp
SLOTHSORT_ALLOWED_ROOTS=

# Internal Manifest & Configuration Directory (Optional)
# Default: ~/.config/slothsort
# XDG_CONFIG_HOME=~/.config

# ------------------------------------------------------------------------------
# Frontend Configuration (Vite + React)
# ------------------------------------------------------------------------------

# URL where the FastAPI backend server is reachable from the browser
VITE_BACKEND_URL=http://127.0.0.1:8000
